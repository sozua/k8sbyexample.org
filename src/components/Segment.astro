---
interface Props {
  empty?: boolean;
}

const { empty = false } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-0 items-start">
  <div class="py-2 md:py-3 md:pr-6 text-gray-300 text-[15px] [&>p]:mb-0">
    <slot name="docs" />
  </div>
  <div
    class:list={[
      "rounded-lg p-4 overflow-x-auto [&>pre]:m-0",
      empty
        ? "bg-transparent border-none"
        : "bg-[#141414] border border-white/[0.06]",
      "mb-4 md:mb-0",
    ]}
  >
    <slot name="code" />
  </div>
</div>
