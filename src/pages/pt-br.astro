---
import Layout from "../components/Layout.astro";
import { modules } from "../data/modules";
import { translations } from "../data/translations";
import { getCollection } from "astro:content";

const lang = "pt-br";
const t = translations[lang];

const allLessons = await getCollection("lessons-pt-br");

function getLessonBySlug(slug: string) {
  return allLessons.find((e) => e.slug.endsWith(slug));
}
---

<Layout title={t.title} lang="pt-BR">
  <div class="fixed top-4 right-4 flex gap-3 text-[13px] text-white/40 z-50">
    <a href="https://github.com/sozua/k8sbyexample.org" class="text-white/40 hover:text-white/70">GitHub</a>
    <button id="grain-toggle" class="text-white/40 hover:text-white/70">grain: <span id="grain-status">on</span></button>
    <a href="/" class="text-white/40 hover:text-white/70">EN</a>
    <span class="text-white/70">PT</span>
  </div>
  <main class="max-w-[560px] mx-auto mb-24 px-6 md:px-6 max-md:px-4">
    <h2 class="mt-12"><a href="/pt-br">{t.title}</a></h2>

    <p class="mt-6 text-white/70">
      <a href="https://kubernetes.io">Kubernetes</a>
      {t.intro1}
    </p>

    <p class="mt-6 text-white/70">
      <em>{t.siteName}</em>
      {t.intro2}
    </p>

    {
      modules.map((mod) => (
        <div class="mt-10">
          <h3 class="text-sm font-medium uppercase tracking-wide text-white/40 mb-3">
            {t.modules[mod.key as keyof typeof t.modules]}
          </h3>
          <ul class="list-none">
            {mod.lessons.map((slug) => {
              const lesson = getLessonBySlug(slug);
              return lesson ? (
                <li class="py-1.5">
                  <a
                    href={`/pt-br/${slug}`}
                    class="text-white/85 font-normal hover:underline"
                  >
                    {lesson.data.title}
                  </a>
                </li>
              ) : (
                <li class="py-1.5 text-white/40">{slug} (coming soon)</li>
              );
            })}
          </ul>
        </div>
      ))
    }

    <p class="mt-12 text-[13px] text-white/35">
      {t.footer}
      <a href="https://gobyexample.com" class="text-white/35 hover:underline"
        >Go by Example</a
      > | <a
        href="https://github.com/sozua/k8sbyexample.org/blob/main/LICENSE"
        class="text-white/35 hover:underline">licença MIT</a
      >
    </p>
  </main>
  <script>
    const btn = document.getElementById('grain-toggle');
    const status = document.getElementById('grain-status');

    function updateStatus() {
      status!.textContent = (window as any).isGrainEnabled() ? 'on' : 'off';
    }

    updateStatus();

    btn?.addEventListener('click', () => {
      (window as any).toggleGrain();
      updateStatus();
    });
  </script>
</Layout>
