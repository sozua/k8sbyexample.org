---
import Layout from '../components/Layout.astro';
import PrevNext from '../components/PrevNext.astro';
import SectionProgress from '../components/SectionProgress.astro';
import CodeblockScripts from '../components/codeblock/CodeblockScripts.astro';
import { getCollection } from 'astro:content';
import { getAllLessons } from '../data/modules';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  const orderedSlugs = getAllLessons();

  const allLessons = lessons.map(e => ({
    slug: e.slug.split('/').pop()!,
    title: e.data.title,
  }));

  return lessons.map((entry) => {
    const slug = entry.slug.split('/').pop()!;
    const idx = orderedSlugs.indexOf(slug);
    const prevSlug = idx > 0 ? orderedSlugs[idx - 1] : null;
    const nextSlug = idx < orderedSlugs.length - 1 ? orderedSlugs[idx + 1] : null;

    const prevLesson = prevSlug
      ? lessons.find(e => e.slug.endsWith(prevSlug))
      : null;
    const nextLesson = nextSlug
      ? lessons.find(e => e.slug.endsWith(nextSlug))
      : null;

    return {
      params: { slug },
      props: {
        entry,
        slug,
        allLessons,
        prev: prevLesson ? { slug: prevSlug, title: prevLesson.data.title } : null,
        next: nextLesson ? { slug: nextSlug, title: nextLesson.data.title } : null,
      },
    };
  });
}

const { entry, slug, allLessons, prev, next } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`K8s by Example: ${entry.data.title}`} description={entry.data.description}>
  <SectionProgress currentSlug={slug} allLessons={allLessons} />
  <main class="max-w-[900px] mx-auto mb-24 px-6 max-md:px-4">
    <h2>
      <a href="/">K8s by Example</a>: {entry.data.title}
    </h2>

    <div class="example-container">
      <Content />
    </div>
    <CodeblockScripts />

    <PrevNext prev={prev} next={next} />

    <p class="mt-12 text-[13px] text-white/35">
      <a href="/" class="text-white/35 hover:underline">Index</a> |
      <a href="https://github.com/sozua/k8sbyexample.org" class="text-white/35 hover:underline">GitHub</a> |
      Use arrow keys to navigate |
      <button
        id="grain-toggle"
        class="text-white/35 hover:underline hover:text-white/35"
        >grain: <span id="grain-status">on</span></button
      >
    </p>
  </main>
  <script>
    const btn = document.getElementById('grain-toggle');
    const status = document.getElementById('grain-status');

    function updateStatus() {
      status!.textContent = (window as any).isGrainEnabled() ? 'on' : 'off';
    }

    updateStatus();

    btn?.addEventListener('click', () => {
      (window as any).toggleGrain();
      updateStatus();
    });
  </script>
</Layout>
